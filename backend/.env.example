# Database URL - Supabase PostgreSQL Configuration
# In your Supabase project dashboard: Settings -> Database -> Connection string
# 
# Recommended: Connection Pooler (Session mode, port 5432 - works across IPv4 & IPv6):
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Alternative: Direct Connection (requires IPv4 add-on or IPv6 network):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Fallback for local Docker PostgreSQL (if used):
# DATABASE_URL=postgresql+psycopg://nagarseva:nagarseva@localhost:5432/nagarseva
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SARVAM_API_KEY=
GNANI_API_KEY=
OPENWEATHERMAP_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INVITE_CODE=
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
